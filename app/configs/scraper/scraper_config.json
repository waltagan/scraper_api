{
  "request_timeout": 22,
  "subpage_timeout": 22,
  "retry_timeout": 30,
  "max_retries": 1,
  "max_subpages": 10,
  "per_domain_concurrent": 4,
  "stagger_delay": 0.5,
  "circuit_breaker_threshold": 3,
  "flush_size": 500,
  "min_content_length": 100,
  "max_concurrent_711": 1200,
  "max_concurrent_decodo": 1200,
  "max_concurrent_evomi": 1200,
  "max_concurrent_per_proxy": 4,
  "rate_limit_enabled": true,
  "rate_limit_providers": {
    "711proxy": { "rate_per_sec": 75.0, "burst_capacity": 250 },
    "decodo": { "rate_per_sec": 70.0, "burst_capacity": 230 },
    "evomi": { "rate_per_sec": 90.0, "burst_capacity": 300 }
  },
  "probe_only_mode": false,
  "evomi_proxy_file": "proxies_evomi.txt",
  "provider_weights": {
    "711proxy": 1,
    "decodo": 1,
    "evomi": 1
  },
  "chunk_size": 360
}
