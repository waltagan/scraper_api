{
  "title": "Scrape Unified - Operations & Saturation",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "type": "query",
        "label": "run_id",
        "datasource": "Prometheus",
        "query": "label_values(scrape_unified_batch_run_seconds_count, run)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput/s por Provider e Etapa (success)",
      "targets": [
        {
          "expr": "sum by (provider, stage) (clamp_min(rate(scrape_unified_requests_total{status=\"success\",run=~\"$run\"}[$__rate_interval]), 0))",
          "legendFormat": "{{provider}}/{{stage}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Erro/s por Provider/Etapa/Tipo",
      "targets": [
        {
          "expr": "sum by (provider, stage, error_type) (clamp_min(rate(scrape_unified_errors_total{run=~\"$run\"}[$__rate_interval]), 0))",
          "legendFormat": "{{provider}}/{{stage}}/{{error_type}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de Sucesso Step1 por Provider (%)",
      "targets": [
        {
          "expr": "100 * sum by (provider) (increase(scrape_unified_requests_total{stage=\"step1\",status=\"success\",run=~\"$run\"}[5m])) / clamp_min(sum by (provider) (increase(scrape_unified_requests_total{stage=\"step1\",run=~\"$run\"}[5m])), 1)",
          "legendFormat": "{{provider}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência Step1 p50/p90/p99 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (clamp_min(rate(scrape_unified_latency_seconds_bucket{stage=\"step1\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, provider) (clamp_min(rate(scrape_unified_latency_seconds_bucket{stage=\"step1\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p90 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, provider) (clamp_min(rate(scrape_unified_latency_seconds_bucket{stage=\"step1\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p99 {{provider}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latência Step2/Step3 p90 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le, stage, provider) (clamp_min(rate(scrape_unified_latency_seconds_bucket{stage=~\"step2|step3\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "{{stage}} {{provider}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tempo Total por Empresa p50/p90/p99 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (clamp_min(rate(scrape_unified_company_total_seconds_bucket{status=\"success\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, provider) (clamp_min(rate(scrape_unified_company_total_seconds_bucket{status=\"success\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p90 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, provider) (clamp_min(rate(scrape_unified_company_total_seconds_bucket{status=\"success\",run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p99 {{provider}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backlog e Fila de Persistência",
      "targets": [
        {
          "expr": "sum by (stage) (scrape_unified_queue_depth{run=~\"$run\"})",
          "legendFormat": "queue {{stage}}"
        },
        {
          "expr": "sum by (mode) (scrape_unified_pending_results_depth{run=~\"$run\"})",
          "legendFormat": "pending {{mode}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inflight por Etapa/Provider",
      "targets": [
        {
          "expr": "sum by (provider, stage) (scrape_unified_inflight_requests{run=~\"$run\"})",
          "legendFormat": "{{provider}}/{{stage}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Persistência no Banco - Latência Flush p50/p90/p99 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, mode) (clamp_min(rate(scrape_unified_batch_flush_seconds_bucket{run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p50 {{mode}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, mode) (clamp_min(rate(scrape_unified_batch_flush_seconds_bucket{run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p90 {{mode}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, mode) (clamp_min(rate(scrape_unified_batch_flush_seconds_bucket{run=~\"$run\"}[$__rate_interval]), 0)))",
          "legendFormat": "p99 {{mode}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Persistência no Banco - Registros por Flush (avg)",
      "targets": [
        {
          "expr": "sum by (mode) (rate(scrape_unified_batch_flush_records_sum{run=~\"$run\"}[$__rate_interval])) / clamp_min(sum by (mode) (rate(scrape_unified_batch_flush_records_count{run=~\"$run\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "{{mode}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Duração do Run Batch p50/p90/p99 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, mode, status) (clamp_min(rate(scrape_unified_batch_run_seconds_bucket{run=~\"$run\"}[10m]), 0)))",
          "legendFormat": "p50 {{mode}}/{{status}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, mode, status) (clamp_min(rate(scrape_unified_batch_run_seconds_bucket{run=~\"$run\"}[10m]), 0)))",
          "legendFormat": "p90 {{mode}}/{{status}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, mode, status) (clamp_min(rate(scrape_unified_batch_run_seconds_bucket{run=~\"$run\"}[10m]), 0)))",
          "legendFormat": "p99 {{mode}}/{{status}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP da API - Inflight e P95",
      "targets": [
        {
          "expr": "scrape_http_inflight_requests",
          "legendFormat": "http inflight"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (clamp_min(rate(scrape_http_request_duration_seconds_bucket[$__rate_interval]), 0)))",
          "legendFormat": "p95 {{path}}"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Saturação do Servidor - CPU%, Memória RSS, FD",
      "targets": [
        {
          "expr": "avg_over_time(scrape_server_cpu_percent[1m])",
          "legendFormat": "cpu%"
        },
        {
          "expr": "avg_over_time(scrape_server_memory_rss_bytes[1m]) / 1024 / 1024",
          "legendFormat": "memory_rss_mb"
        },
        {
          "expr": "avg_over_time(scrape_server_open_fds[1m])",
          "legendFormat": "open_fds"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 42 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Saturação do Servidor - Event Loop Lag e Load",
      "targets": [
        {
          "expr": "avg_over_time(scrape_server_event_loop_lag_seconds[1m])",
          "legendFormat": "event_loop_lag_s"
        },
        {
          "expr": "avg_over_time(scrape_server_loadavg_1m[1m])",
          "legendFormat": "loadavg_1m"
        }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 42 }
    }
  ]
}
